{
  "name": "kirbyup",
  "type": "module",
  "version": "4.0.0-alpha.8",
  "packageManager": "pnpm@11.25.0",
  "description": "Zero-config bundler for Kirby Panel plugins",
  "author": {
    "name": "Johann Schopplich",
    "email": "hello@johannschopplich.com",
    "url": "https://johannschopplich.com"
  },
  "license": "MIT",
  "homepage": "https://kirbyup.getkirby.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johannschopplich/kirbyup.git"
  },
  "bugs": "https://github.com/johannschopplich/kirbyup/issues",
  "keywords": [
    "kirby-cms",
    "kirby-plugin",
    "kirby",
    "cli",
    "panel",
    "bundler"
  ],
  "exports": {
    ".": {
      "types": "./dist/node/index.d.mts",
      "default": "./dist/node/index.mjs"
    },
    "./config": {
      "types": "./dist/client/config.d.mts",
      "default": "./dist/client/config.mjs"
    },
    "./plugin": {
      "types": "./dist/client/plugin.d.mts",
      "default": "./dist/client/plugin.mjs"
    }
  },
  "types": "./dist/node/index.d.mts",
  "bin": {
    "kirbyup": "bin/kirbyup.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:build": "pnpm --filter docs run build",
    "docs:preview": "pnpm --filter docs run preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "bumpp",
    "test": "vitest --no-isolate",
    "test:types": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "ansis": "^4.3.1",
    "c12": "^4.0.0-beta.5",
    "chokidar": "^5.0.0",
    "magic-string": "^1.2.3",
    "perfect-debounce": "^2.1.0",
    "postcss": "^8.5.26",
    "postcss-load-config": "^6.0.1",
    "sass": "^1.103.1",
    "strip-literal": "^4.0.0",
    "vite": "^8.2.2",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@types/node": "^26.4.0",
    "bumpp": "^12.2.2",
    "eslint": "^10.9.1",
    "eslint-flat-config-utils": "^3.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "unplugin-raw": "^0.8.0",
    "utilful": "^3.2.0",
    "vitest": "^4.1.11"
  }
}
