{
  "name": "kirbyup",
  "type": "module",
  "version": "4.0.0-alpha.6",
  "packageManager": "pnpm@10.33.3",
  "description": "Zero-config bundler for Kirby Panel plugins",
  "author": {
    "name": "Johann Schopplich",
    "email": "hello@johannschopplich.com",
    "url": "https://johannschopplich.com"
  },
  "license": "MIT",
  "homepage": "https://kirbyup.getkirby.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johannschopplich/kirbyup.git"
  },
  "bugs": "https://github.com/johannschopplich/kirbyup/issues",
  "keywords": [
    "kirby-cms",
    "kirby-plugin",
    "kirby",
    "cli",
    "panel",
    "bundler"
  ],
  "exports": {
    ".": {
      "types": "./dist/node/index.d.mts",
      "default": "./dist/node/index.mjs"
    },
    "./config": {
      "types": "./dist/client/config.d.mts",
      "default": "./dist/client/config.mjs"
    },
    "./plugin": {
      "types": "./dist/client/plugin.d.mts",
      "default": "./dist/client/plugin.mjs"
    }
  },
  "types": "./dist/node/index.d.mts",
  "bin": {
    "kirbyup": "bin/kirbyup.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "bumpp",
    "test": "vitest --no-isolate",
    "test:types": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/compiler-sfc": "^3.5.34",
    "c12": "^4.0.0-beta.4",
    "cac": "^7.0.0",
    "chokidar": "^5.0.0",
    "consola": "^3.4.2",
    "magic-string": "^0.30.21",
    "nypm": "^0.6.6",
    "pathe": "^2.0.3",
    "perfect-debounce": "^2.1.0",
    "postcss": "^8.5.14",
    "postcss-load-config": "^6.0.1",
    "sass": "^1.99.0",
    "vite": "^8.0.10",
    "vite-plugin-full-reload": "^1.2.0",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@types/node": "^24.12.2",
    "bumpp": "^11.0.1",
    "eslint": "^10.3.0",
    "eslint-flat-config-utils": "^3.2.0",
    "tinyglobby": "^0.2.16",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "unplugin-raw": "^0.7.0",
    "vitest": "^4.1.5"
  }
}
